    "sql_injection":      ["executeQuery", "executeUpdate", "execute", "prepareStatement", "createNativeQuery", "createQuery"],
    "command_injection":  ["exec", "start", "command", "getRuntime"],
    "deserialization":    ["readObject", "fromXML", "fromString", "readValue", "deserialize"],
    "ssrf":               ["openConnection", "openStream", "newCall", "exchange", "getForObject", "postForObject"],
    "path_traversal":     ["resolve", "toFile", "newInputStream", "newOutputStream", "newBufferedReader"],
    "xss_template":       ["setAttribute", "addObject", "include"],
    "weak_crypto":        ["getInstance", "MD5", "SHA1", "DES", "RC4"],
    "redirect":           ["sendRedirect", "setHeader"],
    "logging":            ["info", "warn", "error", "debug", "trace"]
  },
  "javascript": {
    "sql_injection":      ["query", "execute", "raw"],
    "command_injection":  ["exec", "execSync", "spawn", "spawnSync", "execFile"],
    "code_eval":          ["eval", "Function", "vm"],
    "deserialization":    ["parse", "unserialize"],
    "ssrf":               ["request", "fetch", "get", "post", "axios"],
    "path_traversal":     ["readFile", "readFileSync", "writeFile", "writeFileSync", "createReadStream", "createWriteStream"],
    "xss":                ["innerHTML", "outerHTML", "insertAdjacentHTML", "document.write", "dangerouslySetInnerHTML"],
