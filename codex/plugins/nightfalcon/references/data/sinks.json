    "code_eval":          ["eval", "exec", "compile"],
    "deserialization":    ["load", "loads", "Unpickler", "load_all"],
    "ssrf":               ["urlopen", "get", "post", "request", "Session"],
    "path_traversal":     ["open", "read", "write", "send_file", "send_from_directory"],
    "ssti":               ["render_template_string", "Template", "from_string"],
