    "redirect":           ["Redirect"]
  },
  "framework_entry_points": {
    "_comment": "Function/decorator/annotation names that mark externally-reachable entry points. Phase 1 uses these to expand the attack surface.",
    "java":       ["RequestMapping", "GetMapping", "PostMapping", "PutMapping", "DeleteMapping", "PatchMapping", "Path", "GET", "POST", "PUT", "DELETE", "RestController", "Controller", "WebServlet", "ServerEndpoint"],
    "javascript": ["get", "post", "put", "delete", "patch", "use", "route", "router", "Controller", "Get", "Post", "Put", "Delete", "Patch", "Sub", "Pub"],
