class Nightfalcon < Formula
  desc "Multi-client agentic security review harness"
  homepage "https://github.com/intuit/NightFalcon"
  url "https://github.com/intuit/NightFalcon/archive/refs/tags/v@VERSION@.tar.gz"
  sha256 "@SHA256@"
  license all_of: ["Apache-2.0", "CC-BY-SA-4.0"]

  depends_on "python@3.15"

  def python3
    Formula["python@3.15"].opt_bin/"python3.15"
  end

  def install
    system python3, "scripts/release/build-zipapp.py", "--repo", buildpath, "--output-dir", buildpath/"dist"
    libexec.install "dist/nightfalcon-#{version}.pyz"
    (bin/"nightfalcon").write <<~SH
      #!/bin/bash
      exec "#{python3}" "#{libexec}/nightfalcon-#{version}.pyz" "$@"
    SH
  end

  test do
    assert_match "nightfalcon #{version}", shell_output("#{bin}/nightfalcon version")
  end
end
